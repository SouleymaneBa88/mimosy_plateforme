# Variables Docker — DÉVELOPPEMENT. Copier en .env.docker (non versionné) :
#   cp .env.docker.example .env.docker
# Aucune valeur réelle ici : ce fichier est versionné.

# ── PostgreSQL (utilisé à la fois par l'image postgres et par Django) ──
POSTGRES_DB=mimosy
POSTGRES_USER=mimosy
POSTGRES_PASSWORD=A_REMPLACER_mot_de_passe_long_et_aleatoire
DB_HOST=db
DB_PORT=5432

# ── Redis (channel layer temps réel + cache des tickets WebSocket) ──
REDIS_URL=redis://redis:6379/0

# ── Django ──
DEBUG=True
# En développement, une clé de secours est utilisée si ce champ est vide.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend Vite lancé sur la machine.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ── Analyse OCR des pièces d'identité ──
# true : télécharge le modèle TrOCR (~1,3 Go) au premier usage (volume hf_cache).
VERIFICATION_IA_ACTIVE=false

# ── Paiement ──
# "sandbox" : paiement réussi immédiatement, sans PayDunya (développement).
# "paydunya" : redirection vers la vraie page de paiement PayDunya.
PAYMENT_PROVIDER=sandbox
COMMISSION_TAUX=0.10
PAYMENT_INITIE_TIMEOUT_MINUTES=10
# Clés du compte PayDunya (tableau de bord PayDunya → Intégrez notre API).
# Vides ici : ne jamais mettre de vraies valeurs dans ce fichier versionné.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# "test" (sandbox PayDunya) ou "live" (argent réel).
PAYDUNYA_MODE=test
# URL PUBLIQUE du callback : PayDunya ne peut pas joindre localhost.
# En local : https://<id>.ngrok-free.app/api/wallet/webhooks/paydunya/
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_PAYOUT_CALLBACK_URL=
# Adresse du frontend, pour les URLs de retour après paiement.
FRONTEND_BASE_URL=http://localhost:5173
