# MODÈLE versionné de .env.docker : cp .env.docker.example .env.docker
# Aucune valeur réelle ici.

# ── APPLICATION ──
DEBUG=True
# Adresse du frontend Vue : base des URLs de retour après un paiement PayDunya.
FRONTEND_BASE_URL=http://localhost:5173

# ── AUTHENTIFICATION ──
# Clé secrète Django : signe les sessions et les jetons JWT (SimpleJWT).
# Vide en développement : une clé de secours est utilisée (DEBUG=True uniquement).
DJANGO_SECRET_KEY=

# ── DATABASE (PostgreSQL — lu par le conteneur db ET par Django) ──
# POSTGRES_* : crée la base au premier démarrage du conteneur db ;
# Django les lit aussi (DB_NAME/DB_USER/DB_PASSWORD absents).
POSTGRES_DB=mimosy
POSTGRES_USER=mimosy
POSTGRES_PASSWORD=A_REMPLACER_mot_de_passe_long_et_aleatoire
# « db » = nom du service PostgreSQL dans docker-compose.yml.
DB_HOST=db
DB_PORT=5432

# ── REDIS (temps réel : channel layer + cache des tickets WebSocket) ──
# Réseau Docker interne uniquement, jamais publié sur Internet.
REDIS_URL=redis://redis:6379/0

# ── CORS / SÉCURITÉ ──
# Domaines acceptés par Django (ajouter le domaine ngrok pour les callbacks PayDunya).
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à appeler l'API depuis un navigateur (frontend Vue).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origines autorisées à soumettre des formulaires (admin Django).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ── PAIEMENT ──
# sandbox : paiement réussi immédiatement, sans PayDunya (développement).
# paydunya : redirection vers la vraie page de paiement PayDunya.
PAYMENT_PROVIDER=sandbox
# test = sandbox PayDunya (argent fictif) ; live = argent réel.
PAYDUNYA_MODE=test
# Clés du compte PayDunya. SECRETS : jamais dans Git, jamais dans le code.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# URL PUBLIQUE du webhook : PayDunya ne peut pas joindre localhost
# (en local : https://<id>.ngrok-free.app/api/wallet/webhooks/paydunya/).
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_PAYOUT_CALLBACK_URL=
# Commission MIMOSY prélevée à la libération des fonds.
COMMISSION_TAUX=0.10
# Minutes avant qu'un paiement INITIE (sans réponse de PayDunya) soit abandonné.
PAYMENT_INITIE_TIMEOUT_MINUTES=10

# ── AUTRES SERVICES (analyse IA) ──
# OCR des pièces d'identité (TrOCR, ~1,3 Go téléchargés au premier usage).
VERIFICATION_IA_ACTIVE=false
