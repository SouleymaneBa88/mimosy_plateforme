# Copier ce fichier en .env et renseigner de vraies valeurs.
# .env ne doit jamais être versionné (voir .gitignore).

# Django
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DB_HOST=127.0.0.1 DB_NAME=mimosy_db DB_USER=mimosy_user DB_PASSWORD="Mimosy2026Dev!" \
# CORS / CSRF
# Origines autorisées à appeler l'API depuis un navigateur (frontend Vue).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Domaines autorisés à soumettre des formulaires à /admin/ (vide tant
# qu'aucun domaine de production n'existe).
CSRF_TRUSTED_ORIGINS=

# Email (backend console par défaut, aucun envoi réel pour le moment)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Throttling DRF (requêtes autorisées par minute)
THROTTLE_RATE_ANON=100/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_REGISTER=10/min
THROTTLE_RATE_MESSAGE=30/min

# Analyse IA des avis (sentiment + modération). Désactivée par défaut
# car elle nécessite le téléchargement de modèles Hugging Face.
AVIS_ANALYSE_IA_ACTIVE=False

# Analyse IA des documents d'identité (OCR TrOCR). Désactivée par défaut.
# Activer uniquement lorsque torch + transformers sont installés et que le
# modèle microsoft/trocr-base-printed est disponible (~1.3 Go).
VERIFICATION_IA_ACTIVE=False

# Seuil de correspondance OCR (0 < valeur ≤ 1, défaut 0.80).
# En dessous de ce seuil, un champ extrait est considéré comme ne correspondant
# pas aux données d'inscription du prestataire.
# SEUIL_CORRESPONDANCE_CHAMP=0.80

# Paiement : "sandbox" (par défaut, aucun argent réel) ou "paydunya".
PAYMENT_PROVIDER=sandbox
COMMISSION_TAUX=0.10
# Minutes après lesquelles un paiement resté INITIE (réponse de PayDunya
# jamais reçue) est considéré comme abandonné. Défaut : 10.
PAYMENT_INITIE_TIMEOUT_MINUTES=10

# PayDunya (https://developers.paydunya.com) : paiement client et
# déboursement (payout) vers Wave Sénégal / Orange Money Sénégal.
# Ne jamais renseigner de vraies valeurs dans ce fichier .env.example.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# "test" ou "live" — toujours "test" tant que l'intégration n'a pas été
# validée avec un vrai compte marchand PayDunya.
PAYDUNYA_MODE=test
# URLs absolues, joignables par les serveurs PayDunya (donc pas
# localhost en dehors d'un tunnel de développement type ngrok).
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_PAYOUT_CALLBACK_URL=

# Base du frontend Vue, utilisée pour construire les URLs de retour
# après un paiement PayDunya.
FRONTEND_BASE_URL=http://localhost:5173

# Temps réel (Django Channels) : adresse du serveur Redis qui relie les
# process entre eux (channel layer). Laisser vide en développement : un
# channel layer en mémoire est alors utilisé (un seul process).
# En production : obligatoire, et Redis ne doit JAMAIS être accessible depuis
# Internet (réseau privé + mot de passe), par exemple :
#   REDIS_URL=redis://:mot-de-passe@127.0.0.1:6379/0
REDIS_URL=
