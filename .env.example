# MODÈLE versionné de .env (Django hors Docker) : cp .env.example .env
# Aucune valeur réelle ici. Renseigner les vraies valeurs dans .env uniquement.

# ── APPLICATION ──
DEBUG=True
# Adresse du frontend Vue : base des URLs de retour après un paiement PayDunya.
FRONTEND_BASE_URL=http://localhost:5173

# ── AUTHENTIFICATION ──
# Clé secrète Django : signe les sessions et les jetons JWT (SimpleJWT).
# Vide en développement : une clé de secours est utilisée (DEBUG=True uniquement).
DJANGO_SECRET_KEY=

# ── DATABASE (PostgreSQL installé sur la machine) ──
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── REDIS (temps réel : channel layer + cache partagé) ──
# Conteneur local lié à 127.0.0.1 uniquement : docker start mimosy-redis-dev.
# Vide : channel layer en mémoire (un seul process).
REDIS_URL=

# ── CORS / SÉCURITÉ ──
# Domaines acceptés par Django (ajouter le domaine ngrok pour les callbacks PayDunya).
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à appeler l'API depuis un navigateur (frontend Vue).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Origines autorisées à soumettre des formulaires (admin Django).
CSRF_TRUSTED_ORIGINS=
# Limites de requêtes DRF (par minute).
THROTTLE_RATE_ANON=100/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_LOGIN=10/min
THROTTLE_RATE_REGISTER=10/min
THROTTLE_RATE_MESSAGE=30/min

# ── PAIEMENT ──
# sandbox : paiement réussi immédiatement, sans PayDunya (développement).
# paydunya : redirection vers la vraie page de paiement PayDunya.
PAYMENT_PROVIDER=sandbox
# test = sandbox PayDunya (argent fictif) ; live = argent réel.
PAYDUNYA_MODE=test
# Clés du compte PayDunya. SECRETS : jamais dans Git, jamais dans le code.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Retrait de DÉMONSTRATION (PAYDUNYA_MODE=test uniquement) : l'API de déboursement
# PayDunya n'accepte que des clés LIVE. true = parcours interne complet, statut
# SIMULE, AUCUN déboursement PayDunya. Ignoré en PAYDUNYA_MODE=live.
PAYDUNYA_PAYOUT_DEMO=false
# URL PUBLIQUE du webhook : PayDunya ne peut pas joindre localhost
# (en local : https://<id>.ngrok-free.app/api/wallet/webhooks/paydunya/).
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_PAYOUT_CALLBACK_URL=
# Commission MIMOSY prélevée à la libération des fonds.
COMMISSION_TAUX=0.10
# Minutes avant qu'un paiement INITIE (sans réponse de PayDunya) soit abandonné.
PAYMENT_INITIE_TIMEOUT_MINUTES=10

# ── IA GÉNÉRATIVE (voir apps/common/ia_fournisseurs.py) ──
# Fournisseur : gemini, anthropic, ou auto (Gemini si sa clé existe, sinon Claude).
IA_FOURNISSEUR=auto
# Clé Gemini (Google AI Studio). SECRET : jamais dans Git, jamais dans le code.
GEMINI_API_KEY=
# Modèles essayés dans l'ordre (un modèle peut être retiré ou saturé).
GEMINI_MODELES_RAPIDES=gemini-flash-lite-latest,gemini-3-flash-preview
GEMINI_MODELES_ANALYSE=gemini-3-flash-preview,gemini-flash-lite-latest
# Synthèse vocale des assistantes IA (Aby : profil, Fassa : entretien).
# Modèles essayés dans l'ordre : chacun a son propre quota ; un modèle épuisé
# (HTTP 429) est mis en pause et le suivant prend le relais.
# ATTENTION : l'offre gratuite Gemini limite chaque modèle de voix à quelques
# requêtes par jour, insuffisant pour un entretien : activez la facturation
# du projet Google AI Studio pour une voix stable.
GEMINI_MODELES_VOIX=gemini-3.1-flash-tts-preview,gemini-3.8-flash-tts,gemini-2.5-pro-preview-tts,gemini-2.5-flash-preview-tts
# Modèles de voix pour le wolof (vide = GEMINI_MODELES_VOIX sans gemini-3.8-flash-tts,
# dont l'audio wolof est rejeté à chaque phrase par le contrôle de durée).
GEMINI_MODELES_VOIX_WO=
GEMINI_VOIX_ABY=Sulafat
GEMINI_VOIX_FASSA=Vindemiatrix
# Conservation (secondes) des phrases déjà synthétisées (30 jours).
VOIX_CACHE_SECONDES=2592000
# Transcription des réponses orales (modèle dédié, puis GEMINI_MODELES_RAPIDES).
GEMINI_MODELES_TRANSCRIPTION=gemini-3.5-transcribe
THROTTLE_RATE_VOIX=60/min

# ── PARCOURS DE VÉRIFICATION DU PRESTATAIRE ──
# IA (Gemini ou Claude) pour l'assistant de profil, la lecture de la pièce
# d'identité et du justificatif, la cohérence, l'entretien (questions, voix,
# transcription) et la synthèse. false (ou sans clé) : règles automatiques,
# le parcours reste utilisable. Si activé, la PIÈCE D'IDENTITÉ, le justificatif,
# le profil et les réponses de l'entretien sont envoyés au fournisseur d'IA.
PARCOURS_IA_ACTIVE=false
VERIFICATION_IA_MODELE=claude-opus-5-5
VERIFICATION_IA_TIMEOUT=20
# Langues de communication d'Aby et de Fassa (fr, en, wo). Le profil, les
# rapports et la synthèse restent TOUJOURS en français.
PARCOURS_LANGUES=fr,en,wo
# Voix serveur en wolof : vide = pas de voix (le texte s'affiche) ; « gemini » =
# essai EXPÉRIMENTAL (Gemini TTS ne documente pas le wolof : faire valider par un
# locuteur natif avant la production).
VOIX_WOLOF=
# Transcription du wolof par Kiriku (AIHubSN/Kiriku-Wolof-ASR, service optionnel :
# docker compose --profile asr-wolof up -d). Vide : Gemini avec une consigne wolof.
ASR_WOLOF_URL=
ASR_WOLOF_TIMEOUT=60
# Durée maximale de l'entretien professionnel avec Fassa (secondes).
ENTRETIEN_DUREE_MAX_SECONDES=300
# Taille maximale de l'enregistrement vidéo de l'entretien (octets, 60 Mo).
ENTRETIEN_ENREGISTREMENT_TAILLE_MAX=62914560
THROTTLE_RATE_PARCOURS=60/min

# ── EMAIL (Brevo) ──
# Clé API Brevo (Brevo > SMTP & API > Clés API). SECRET : jamais dans Git,
# jamais dans le code. Vide : les e-mails s'affichent dans le terminal (console).
BREVO_API_KEY=
# Expéditeur : doit être une adresse/un domaine validé dans Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MIMOSY
# Durée de validité du lien de confirmation d'e-mail (heures).
EMAIL_VERIFICATION_DUREE_HEURES=24
# Délai minimum entre deux envois de lien pour un même compte (secondes).
EMAIL_VERIFICATION_DELAI_RENVOI_SECONDES=60
# Renvois de lien autorisés par IP (anti-spam).
THROTTLE_RATE_VERIFICATION_EMAIL=5/hour
# Les liens de l'e-mail pointent vers FRONTEND_BASE_URL/verifier-email.

# ── AUTRES SERVICES (analyse IA) ──
# Analyse IA des avis (sentiment + modération) : nécessite des modèles Hugging Face.
AVIS_ANALYSE_IA_ACTIVE=True
# OCR des pièces d'identité (TrOCR, ~1,3 Go téléchargés au premier usage).
VERIFICATION_IA_ACTIVE=True

# Fallback IA de la recherche intelligente : suggestions (services/catégories
# réels du catalogue) quand la recherche ne trouve aucun résultat.
RECHERCHE_IA_ACTIVE=false
# Mimo, l'assistant IA client (pré-diagnostic + photo) : même fournisseur
# (IA_FOURNISSEUR). Sans lui, le pré-diagnostic par règles prend le relais.
MIMO_IA_ACTIVE=false
MIMO_IA_TIMEOUT=20
# Taille maximale d'une photo jointe à une demande (octets, 5 Mo par défaut).
PIECE_JOINTE_TAILLE_MAX_OCTETS=5242880
# Clé API Claude (Anthropic). SECRET : jamais dans Git, jamais dans le code.
ANTHROPIC_API_KEY=
# Optionnels : RECHERCHE_IA_MODELE (défaut claude-opus-5),
# RECHERCHE_IA_TIMEOUT (secondes, défaut 15), RECHERCHE_IA_CACHE_SECONDES (défaut 3600).

# ── OPTIONS (décommenter si besoin) ──
# Seuil de correspondance OCR (0 < valeur ≤ 1, défaut 0.80) :
# SEUIL_CORRESPONDANCE_CHAMP=0.80
