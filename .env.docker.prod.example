# Variables Docker — PRODUCTION. Copier en .env.docker.prod (non versionné) :
#   cp .env.docker.prod.example .env.docker.prod
# Remplacer TOUTES les valeurs A_REMPLACER. Aucune valeur réelle ici.

# ── PostgreSQL ──
POSTGRES_DB=mimosy
POSTGRES_USER=mimosy
POSTGRES_PASSWORD=A_REMPLACER_mot_de_passe_long_et_aleatoire
DB_HOST=db
DB_PORT=5432

# ── Redis (réseau Docker interne uniquement, jamais publié) ──
REDIS_URL=redis://redis:6379/0

# ── Django ──
DEBUG=False
# Obligatoire en production. Générer par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=A_REMPLACER
# Nom de domaine public (et « backend » pour les requêtes internes de nginx).
ALLOWED_HOSTS=mimosy.example,backend
# Origine publique de MIMOSY (celle servie par nginx) : API, WebSocket et CSRF.
CORS_ALLOWED_ORIGINS=https://mimosy.example
CSRF_TRUSTED_ORIGINS=https://mimosy.example
# true en production réelle (HTTPS obligatoire). false UNIQUEMENT pour tester
# la configuration de production en local, sans certificat.
HTTPS_ACTIF=true
FRONTEND_BASE_URL=https://mimosy.example

VERIFICATION_IA_ACTIVE=false
