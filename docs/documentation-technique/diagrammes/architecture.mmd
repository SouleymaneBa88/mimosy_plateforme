        PG[("PostgreSQL 16<br/>SOURCE DE VÉRITÉ<br/>volume postgres_data")]
        REDIS[("Redis 7.4<br/>channel layer + cache<br/>(tickets WebSocket)")]
        MEDIA[("volume media<br/>photos, pièces, preuves")]
